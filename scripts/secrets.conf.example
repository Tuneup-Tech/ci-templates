# ---------------------------------------------------------------------------
# secrets.conf.example — copy to secrets.conf and fill in your values
# secrets.conf is gitignored and will never be committed
# ---------------------------------------------------------------------------

SSH_HOST="your-server-ip-or-hostname"
SSH_PORT="2222"
SSH_USERNAME="root"

# Absolute path to your private key file
# On Windows (Git Bash): use /c/Users/<yourname>/.ssh/id_ed25519
# On Linux/macOS:        use $HOME/.ssh/id_ed25519
SSH_KEY_FILE="/c/Users/yourname/.ssh/id_ed25519"

# Root folder where all projects live locally (used to auto-detect .env.production)
# On Windows PowerShell: D:\Projects
# On WSL/Git Bash:       /mnt/d/Projects
PROJECTS_ROOT="D:\Projects"

# ---------------------------------------------------------------------------
# ENV_PATH overrides — only needed for repos whose local folder name
# doesn't match the GitHub repo name, or lives in a subdirectory.
# Format: ENV_PATH_<reponame with hyphens replaced by underscores>
# ---------------------------------------------------------------------------
# ENV_PATH_roundcircle="D:\Projects\RC\roundcircle\.env.production"
# ENV_PATH_true_cost="D:\Projects\RC\true-cost\BE\.env.production"
# ENV_PATH_true_cost_fe="D:\Projects\RC\true-cost\FE\.env.production"
# ENV_PATH_tuneuptech="D:\Projects\Tuneuptech\Coming Soon\.env.production"


# ---------------------------------------------------------------------------
# Repos to receive these secrets (org/repo format)
# ---------------------------------------------------------------------------
REPOS=(
  "Tuneup-Tech/fin-app"
  "Tuneup-Tech/tuneuptech"
  "Tuneup-Tech/true-cost-be"
  "Tuneup-Tech/true-cost-fe"
  "Tuneup-Tech/roundcircle"
  "Tuneup-Tech/traefik"
  "Tuneup-Tech/uptime"
  "Tuneup-Tech/ci-templates"
)
